{
  "manifest_version": 3,
  "name": "Delete & Relist Facebook Marketplace \u2014 Relistify V2",
  "short_name": "Relistify V2",
  "version": "2.0.4",
  "description": "Local-first Facebook Marketplace relister. Delete and relist your listings in one click \u2014 photos, price drops, details kept intact without external servers or logins.",
  "action": {
    "default_icon": {
      "16": "icon-gold16.png",
      "48": "icon-gold48.png",
      "128": "icon-gold128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Relistify V2"
  },
  "icons": {
    "16": "icon-gold16.png",
    "48": "icon-gold48.png",
    "128": "icon-gold128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://m.facebook.com/*",
    "https://*.facebook.com/*",
    "https://*.fbcdn.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*"
      ],
      "js": [
        "listingExtractor.js",
        "contentScript.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*"
      ],
      "resources": [
        "assets/*",
        "icon128.png",
        "icon-gold128.png"
      ]
    }
  ],
  "minimum_chrome_version": "88",
  "version_name": "2.0.4-extractor"
}