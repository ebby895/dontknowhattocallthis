{
   "action": {
      "default_icon": {
         "128": "images/icon128.png",
         "16": "images/icon16.png",
         "48": "images/icon48.png"
      },
      "default_title": "AutoList Pro: Facebook Marketplace"
   },
   "background": {
      "service_worker": "background.js"
   },
   "commands": {
      "toggle-pin-panel": {
         "description": "Toggle AutoList Pro pinned side panel",
         "suggested_key": {
            "default": "Ctrl+Shift+Y",
            "mac": "Command+Shift+Y"
         }
      },
      "reload-extension": {
         "description": "Reload AutoList Pro",
         "global": true,
         "suggested_key": {
            "default": "Ctrl+Shift+Space",
            "mac": "Command+Shift+Space"
         }
      }
   },
   "content_scripts": [ {
      "all_frames": false,
      "js": [ "mediaDB.js", "content/shared_scrapers.js", "content/dom_helpers.js", "content/from_published_scraper.js", "content/scrape_actions.js", "content/event_bridge.js", "content/content_selling.js", "content/bulk_import_selling.js", "content/content_main.js" ],
      "match_about_blank": false,
      "matches": [ "https://www.facebook.com/marketplace/*", "https://m.facebook.com/marketplace/*" ],
      "run_at": "document_idle"
   } ],
   "description": "Marketplace automation tools for Facebook Marketplace sellers.",
   "homepage_url": "https://krash2501-cmyk.github.io/fast4mp-site/",
   "host_permissions": [ "https://www.facebook.com/*", "https://m.facebook.com/*", "https://www.fbsbx.com/*" ],
   "icons": {
      "128": "images/icon128.png",
      "16": "images/icon16.png",
      "48": "images/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "AutoList Pro: Facebook Marketplace",
   "permissions": [ "tabs", "scripting", "storage", "alarms", "unlimitedStorage", "activeTab", "windows", "sidePanel", "notifications" ],
   "side_panel": {
      "default_path": "popup.html"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.5",
   "web_accessible_resources": [ {
      "matches": [ "https://www.facebook.com/*" ],
      "resources": [ "popup.html", "styles.css", "images/*" ]
   }, {
      "matches": [ "https://www.facebook.com/*" ],
      "resources": [ "content/bridge_page.js" ]
   } ]
}
